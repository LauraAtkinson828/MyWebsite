---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactSection from '../components/ContactSection.astro';
import EducationSection from '../components/EducationSection.astro';
import ExperienceSection from '../components/ExperienceSection.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SkillsSection from '../components/SkillsSection.astro';
---

<BaseLayout>
  <SiteHeader />
  <main id="main">
    <section class="hero" id="top" aria-labelledby="page-title">
      <div class="hero-shell shell">
        <div class="hero-copy">
          <h1 id="page-title">Laura<br /><span>Atkinson</span></h1>
          <p class="hero-summary">Turning scientific discovery into meaningful healthcare impact.</p>
          <p class="hero-detail">Biomedical Science student exploring genomics, precision medicine, and the future of healthcare.</p>
          <div class="hero-actions">
            <a class="primary-link" href="#experience">Explore my experience <span aria-hidden="true">↘</span></a>
            <a class="secondary-link" href="#contact">Get in touch <span aria-hidden="true">↗</span></a>
          </div>
        </div>
      </div>
    </section>

    <section class="about-section" id="about" aria-labelledby="about-title">
      <div class="shell about-grid">
        <div class="about-label">
          <p class="eyebrow">A little about me</p>
          <h2 id="about-title">About</h2>
        </div>
        <div class="about-copy">
          <p class="about-lead">Biomedical Science student with a passion for precision medicine, genomics, and improving patient care through science.</p>
          <p class="placeholder">I am currently studying Biomedical Science at the University of Liverpool, where I have developed a strong interest in genomics, personalised medicine, and the translation of scientific research into healthcare practice. Through academic projects, work experience, and workshops, I enjoy combining scientific understanding with communication, collaboration, and problem-solving. I am particularly interested in careers that bridge science and patient impact, including cancer genomics, oncology, medical affairs, and scientific communications.</p>
          <a href="#education" class="text-link">More about my background <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </section>

    <ExperienceSection />
    <SkillsSection />
    <EducationSection />
  </main>
  <ContactSection />
</BaseLayout>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    display: grid;
    min-height: min(660px, calc(100svh - 220px));
    align-items: center;
    overflow: hidden;
    background: #092d46;
    color: var(--white);
  }

  .hero::before,
  .hero::after {
    position: absolute;
    z-index: -1;
    inset: 0;
    content: '';
  }

  .hero::before {
    z-index: -2;
    background-image: url('https://images.unsplash.com/photo-1576086213369-97a306d36557?auto=format&fit=crop&w=2200&q=88');
    background-position: center;
    background-size: cover;
    filter: saturate(0.72) contrast(1.04);
  }

  .hero::after {
    background: linear-gradient(90deg, rgba(5, 27, 48, 0.8), rgba(7, 42, 61, 0.46));
  }

  .hero-shell {
    display: grid;
    grid-template-columns: minmax(0, 690px);
    padding-block: 72px;
  }

  .hero-copy {
    max-width: 690px;
    animation: rise-in 700ms ease-out both;
  }

  @keyframes rise-in {
    from {
      opacity: 0;
      transform: translateY(12px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .eyebrow {
    margin: 0 0 22px;
    color: var(--lime);
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
  }

  h1 {
    margin: 0;
    color: var(--white);
    font-family: var(--serif);
    font-size: 76px;
    font-weight: 400;
    line-height: 0.98;
  }

  h1 span {
    color: var(--lime);
    font-style: italic;
  }

  .hero-summary {
    max-width: 440px;
    margin: 26px 0 0;
    font-family: var(--serif);
    font-size: 29px;
    line-height: 1.3;
  }

  .hero-detail {
    max-width: 430px;
    margin: 13px 0 0;
    color: #d0e0e5;
    font-size: 14px;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 22px;
    align-items: center;
    margin-top: 28px;
  }

  .primary-link,
  .secondary-link,
  .text-link {
    font-size: 13px;
    font-weight: 600;
    text-decoration: none;
  }

  .primary-link {
    display: inline-flex;
    min-height: 46px;
    align-items: center;
    gap: 18px;
    padding: 0 16px;
    background: var(--lime);
    color: #092d46;
  }

  .primary-link span,
  .text-link span {
    color: #087d91;
    font-size: 17px;
  }

  .secondary-link {
    color: var(--white);
  }

  .text-link {
    color: var(--green-dark);
  }

  .secondary-link span {
    margin-left: 5px;
    color: var(--lime);
  }

  .about-section {
    padding-block: 80px;
    background: var(--white);
  }

  .about-grid {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: 80px;
  }

  .about-label .eyebrow {
    margin-bottom: 12px;
  }

  .about-label h2 {
    margin: 0;
    font-family: var(--serif);
    font-size: 48px;
    font-weight: 400;
    line-height: 1.1;
  }

  .about-copy {
    max-width: 650px;
  }

  .about-lead {
    margin: 0;
    font-family: var(--serif);
    font-size: 26px;
    line-height: 1.4;
  }

  .about-copy .placeholder {
    max-width: 560px;
    margin: 15px 0 20px;
    color: var(--muted);
    font-size: 14px;
  }

  .text-link span {
    margin-left: 5px;
    color: var(--coral);
  }

  @media (max-width: 900px) {
    h1 {
      font-size: 64px;
    }

    .hero-art {
      min-height: 400px;
    }

    .about-grid {
      gap: 44px;
    }
  }

  @media (max-width: 700px) {
    .hero::before {
      background-position: center;
    }

    .hero::after {
      background: rgba(5, 31, 49, 0.64);
    }

    .hero-shell {
      padding-block: 52px;
    }

    h1 {
      font-size: 58px;
    }

    .hero-summary {
      margin-top: 20px;
      font-size: 25px;
    }

    .hero-actions {
      gap: 16px;
      margin-top: 22px;
    }

    .about-section {
      padding-block: 58px;
    }

    .about-grid {
      grid-template-columns: 1fr;
      gap: 24px;
    }

    .about-label h2 {
      font-size: 40px;
    }

    .about-lead {
      font-size: 23px;
    }
  }
</style>
